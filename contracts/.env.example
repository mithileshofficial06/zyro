# Copy to contracts/.env. Gitignored — never commit a key.

# A funded Base Sepolia key. ~0.05 ETH covers the deployment and a 12-tx series.
PRIVATE_KEY=0x

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Set by DeployZyroRouter.s.sol's output, consumed by SwapSeries.s.sol.
# AQUA is also read by NetworkConfig on a network that already has one — on
# Base Sepolia it does not, so the deploy script deploys 1inch's own source.
AQUA=
ZYRO_ROUTER=
ZYRO_LENS=

# Optional overrides for SwapSeries. Ten steps of 50 tokens walks the position
# from its target to its soft bound, which is where the penalty is fully
# ramped — the interesting end of the curve.
# SWAP_STEPS=10
# SWAP_STEP_AMOUNT=50000000000000000000

# For --verify on the deployment.
ETHERSCAN_API_KEY=

# --- The Graph -------------------------------------------------------------
# Not used by Foundry; kept here so there is one gitignored place for secrets
# rather than four. Read by subgraph/mcp/check.mjs and by whatever MCP client
# you register subgraph/mcp/mcp.config.json with.

# Studio -> API Keys. Treat it like a password: anyone holding it queries the
# gateway on your behalf and is billed for it.
THEGRAPH_GATEWAY_API_KEY=

# The `Qm...` CIDv0 that `graph deploy` prints as "Build completed", which
# Studio also shows as the deployment id. Pin this rather than the subgraph
# id: a subgraph id resolves to whatever version is current, so a redeploy
# silently changes what an agent is querying.
#
# MCP tools that take a deployment id want the `0x...` form of the same hash.
# `node subgraph/mcp/check.mjs` prints the conversion.
ZYRO_SUBGRAPH_DEPLOYMENT_ID=
