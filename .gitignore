# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/dry-run/
contracts/.env

# swap-vm / aqua resolve their Solidity deps via npm into node_modules,
# referenced by remappings.txt — not via forge submodules (spec §15).
# contracts/lib/ is NOT ignored: those are git submodules pinned to exact
# commits, and CI checks them out with submodules:recursive.
node_modules/
contracts/node_modules/

# TypeScript / JS
dist/
build/
*.tsbuildinfo
.pnpm-store/
coverage/

# Subgraph codegen
subgraph/generated/
subgraph/build/

# Next.js console
apps/console/.next/
apps/console/out/

# Environment / secrets — never commit a key
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Subgraph
subgraph/generated/
subgraph/build/
subgraph/node_modules/
subgraph/tests/.latest.json
subgraph/tests/.latest.json

# Substreams
substreams/target/
substreams/src/abi/*.rs
!substreams/src/abi/mod.rs

# Local-chain broadcast artifacts (anvil). Real testnet/mainnet runs are kept.
contracts/broadcast/*/31337/
