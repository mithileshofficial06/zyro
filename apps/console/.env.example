# The deployed subgraph's query endpoint. Studio gives you this after
# `graph deploy`; the decentralised network gives you a gateway URL.
#
# Pin the version rather than using `/version/latest`. The console's
# verification panel compares published numbers against the chain, and
# `latest` silently repoints at a redeploy — so a panel that was green can go
# red without anything having been re-verified.
SUBGRAPH_URL=https://api.studio.thegraph.com/query/1758820/zyro/v0.0.2

# Base Sepolia RPC. Server-side only — the console proxies every call through
# app/api so a provider key never reaches the browser.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
